# GitOps: Argo CD. The admin password is generated by Argo CD on first start and stored in the Secret
# argocd-initial-admin-secret.

resource "helm_release" "argocd" {
  count = var.enable_gitops ? 1 : 0

  name       = "argocd"
  repository = "https://argoproj.github.io/argo-helm"
  chart      = "argo-cd"
  version    = local.platform_chart_versions.argo_cd
  namespace  = kubernetes_namespace_v1.platform["argocd"].metadata[0].name
  timeout    = 600

  values = [yamlencode({
    global = {
      # The chart's own NetworkPolicy objects stay off: the policies of every platform namespace are in
      # platform-security.tf and follow var.enable_network_policies.
      networkPolicy = { create = false }
    }
    controller = {
      metrics = { enabled = true, serviceMonitor = { enabled = local.platform_service_monitors } }
    }
    server = {
      metrics = { enabled = true, serviceMonitor = { enabled = local.platform_service_monitors } }
    }
    repoServer = {
      metrics = { enabled = true, serviceMonitor = { enabled = local.platform_service_monitors } }
    }
    applicationSet = {
      metrics = { enabled = true, serviceMonitor = { enabled = local.platform_service_monitors } }
    }
  })]

  depends_on = [
    terraform_data.cluster_ready,
    # The ServiceMonitor kind is installed by kube-prometheus-stack.
    helm_release.kube_prometheus_stack,
  ]
}
