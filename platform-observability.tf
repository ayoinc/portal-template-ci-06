# Observability: kube-prometheus-stack (Prometheus Operator, Prometheus, Alertmanager, Grafana, node exporter,
# kube-state-metrics), Loki in a single replica with a persistent volume, and Alloy as the log collector.
# The Grafana admin password is generated by the chart and stored in the Secret kube-prometheus-stack-grafana.

locals {
  # Service of the Loki release, as seen from the other pods of the monitoring namespace.
  platform_loki_url = "http://loki:3100"

  # Scrape targets of components whose charts have no ServiceMonitor of their own.
  platform_extra_service_monitors = concat(
    var.enable_service_mesh ? [{
      name              = "istiod"
      namespaceSelector = { matchNames = ["istio-system"] }
      selector          = { matchLabels = { istio = "pilot" } }
      endpoints         = [{ port = "http-monitoring", interval = "30s" }]
    }] : [],
  )

  platform_extra_pod_monitors = concat(
    var.enable_opa ? [{
      name                = "gatekeeper"
      namespaceSelector   = { matchNames = ["gatekeeper-system"] }
      selector            = { matchLabels = { "gatekeeper.sh/system" = "yes" } }
      podMetricsEndpoints = [{ port = "metrics", interval = "30s" }]
    }] : [],
  )
}

resource "helm_release" "kube_prometheus_stack" {
  count = var.enable_observability ? 1 : 0

  name       = "kube-prometheus-stack"
  repository = "https://prometheus-community.github.io/helm-charts"
  chart      = "kube-prometheus-stack"
  version    = local.platform_chart_versions.kube_prometheus_stack
  namespace  = kubernetes_namespace_v1.platform["monitoring"].metadata[0].name
  timeout    = 900

  values = [yamlencode({
    # The control plane of a managed cluster is run by the cloud provider and cannot be scraped; kube-proxy listens
    # for metrics on localhost only. Without these switches their "target down" alerts would fire permanently.
    kubeControllerManager = { enabled = false }
    kubeScheduler         = { enabled = false }
    kubeEtcd              = { enabled = false }
    kubeProxy             = { enabled = false }
    # GKE runs its own managed kube-dns, which does not serve the CoreDNS metrics endpoint this target scrapes.
    coreDns = { enabled = local.cloud.name != "gcp" }

    prometheus = {
      prometheusSpec = {
        retention = var.prometheus_retention
        externalLabels = {
          cluster = local.cloud.cluster_name
        }
        # Pick up the ServiceMonitor, PodMonitor, Probe and PrometheusRule objects of every namespace, not only the
        # ones this release creates.
        serviceMonitorSelectorNilUsesHelmValues = false
        podMonitorSelectorNilUsesHelmValues     = false
        probeSelectorNilUsesHelmValues          = false
        ruleSelectorNilUsesHelmValues           = false
        storageSpec = {
          volumeClaimTemplate = {
            spec = {
              storageClassName = local.cloud.storage_class
              accessModes      = ["ReadWriteOnce"]
              resources        = { requests = { storage = var.prometheus_storage_size } }
            }
          }
        }
      }
      additionalServiceMonitors = local.platform_extra_service_monitors
      additionalPodMonitors     = local.platform_extra_pod_monitors
    }

    alertmanager = {
      alertmanagerSpec = {
        storage = {
          volumeClaimTemplate = {
            spec = {
              storageClassName = local.cloud.storage_class
              accessModes      = ["ReadWriteOnce"]
              resources        = { requests = { storage = "2Gi" } }
            }
          }
        }
      }
    }

    grafana = {
      # One replica with a ReadWriteOnce volume: the old pod has to release the volume before the new one starts.
      deploymentStrategy = { type = "Recreate" }
      persistence = {
        enabled          = true
        storageClassName = local.cloud.storage_class
        size             = "10Gi"
      }
      additionalDataSources = [{
        name      = "Loki"
        type      = "loki"
        uid       = "loki"
        access    = "proxy"
        url       = local.platform_loki_url
        isDefault = false
      }]
    }
  })]

  depends_on = [terraform_data.cluster_ready]
}

resource "helm_release" "loki" {
  count = var.enable_observability ? 1 : 0

  name       = "loki"
  repository = "https://grafana-community.github.io/helm-charts"
  chart      = "loki"
  version    = local.platform_chart_versions.loki
  namespace  = kubernetes_namespace_v1.platform["monitoring"].metadata[0].name
  timeout    = 600

  values = [yamlencode({
    # One Loki process that stores chunks and index on its own volume. Enough for a cluster of this size; move to
    # object storage and the Distributed mode when the log volume outgrows one disk.
    deploymentMode = "Monolithic"

    loki = {
      # Single tenant: no X-Scope-OrgID header is needed to write or query.
      auth_enabled = false
      commonConfig = { replication_factor = 1 }
      storage      = { type = "filesystem" }
      schemaConfig = {
        configs = [{
          from         = "2024-04-01"
          store        = "tsdb"
          object_store = "filesystem"
          schema       = "v13"
          index        = { prefix = "index_", period = "24h" }
        }]
      }
      limits_config = { retention_period = var.loki_retention }
      compactor = {
        retention_enabled    = true
        delete_request_store = "filesystem"
      }
    }

    singleBinary = {
      replicas = 1
      persistence = {
        enabled      = true
        storageClass = local.cloud.storage_class
        size         = var.loki_storage_size
      }
    }

    # The components of the other deployment modes.
    read    = { replicas = 0 }
    write   = { replicas = 0 }
    backend = { replicas = 0 }

    # Not needed by a single replica that is reached directly on its Service.
    gateway      = { enabled = false }
    chunksCache  = { enabled = false }
    resultsCache = { enabled = false }
    lokiCanary   = { enabled = false }
    test         = { enabled = false }

    monitoring = {
      serviceMonitor = { enabled = true }
    }
  })]

  depends_on = [
    terraform_data.cluster_ready,
    # The ServiceMonitor kind is installed by kube-prometheus-stack.
    helm_release.kube_prometheus_stack,
  ]
}

resource "helm_release" "alloy" {
  count = var.enable_observability ? 1 : 0

  name       = "alloy"
  repository = "https://grafana.github.io/helm-charts"
  chart      = "alloy"
  version    = local.platform_chart_versions.alloy
  namespace  = kubernetes_namespace_v1.platform["monitoring"].metadata[0].name
  timeout    = 600

  values = [yamlencode({
    # A DaemonSet (the chart's default controller): each pod tails the container log files of its own node.
    alloy = {
      # Read positions are kept on the node, so a restarted collector continues where the previous one stopped.
      storagePath = "/var/lib/alloy"
      mounts = {
        varlog = true
        extra  = [{ name = "positions", mountPath = "/var/lib/alloy" }]
      }
      configMap = {
        content = <<-EOT
          // Pods scheduled on the node this collector runs on.
          discovery.kubernetes "pods" {
            role = "pod"

            selectors {
              role  = "pod"
              field = "spec.nodeName=" + sys.env("HOSTNAME")
            }
          }

          discovery.relabel "pod_logs" {
            targets = discovery.kubernetes.pods.targets

            rule {
              source_labels = ["__meta_kubernetes_namespace"]
              target_label  = "namespace"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_name"]
              target_label  = "pod"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_container_name"]
              target_label  = "container"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
              target_label  = "app"
            }

            rule {
              source_labels = ["__meta_kubernetes_pod_node_name"]
              target_label  = "node"
            }

            // Log files of the container as the kubelet writes them on the node.
            rule {
              source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
              separator     = "/"
              target_label  = "__path__"
              replacement   = "/var/log/pods/*$1/*.log"
            }
          }

          local.file_match "pod_logs" {
            path_targets = discovery.relabel.pod_logs.output
          }

          loki.source.file "pod_logs" {
            targets    = local.file_match.pod_logs.targets
            forward_to = [loki.process.pod_logs.receiver]
          }

          // Strip the container runtime's line prefix (timestamp, stream, flags).
          loki.process "pod_logs" {
            stage.cri {}

            forward_to = [loki.write.default.receiver]
          }

          loki.write "default" {
            endpoint {
              url = "${local.platform_loki_url}/loki/api/v1/push"
            }

            external_labels = {
              cluster = "${local.cloud.cluster_name}",
            }
          }
        EOT
      }
    }
    controller = {
      volumes = {
        extra = [{
          name     = "positions"
          hostPath = { path = "/var/lib/alloy", type = "DirectoryOrCreate" }
        }]
      }
      # Collect the logs of tainted node pools too.
      tolerations = [{ operator = "Exists", effect = "NoSchedule" }]
    }
  })]

  depends_on = [
    terraform_data.cluster_ready,
    helm_release.loki,
  ]
}
